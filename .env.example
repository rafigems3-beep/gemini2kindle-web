# ==========================================
# Gemini2Kindle Web — Environment Variables
# ==========================================

# WAJIB: PIN keamanan untuk melindungi semua endpoint POST (dicocokkan dengan header X-App-Pin)
APP_PIN=ganti-dengan-pin-pribadi-anda

# Engine render LaTeX ke PNG 300 DPI transparan:
# - auto       : Utamakan Node.js MathJax 3 + Resvg (kualitas terbaik), fallback otomatis ke matplotlib
# - mathjax    : Paksa Node.js MathJax 3 + Resvg
# - matplotlib : Mode ringan pure-Python (matplotlib.mathtext)
MATH_ENGINE=auto
MATH_DPI=300
MATH_NODE_TIMEOUT=45

# Metadata EPUB default
DEFAULT_AUTHOR=Gemini
DEFAULT_LANGUAGE=id

# ==========================================
# Konfigurasi Pengiriman ke Kindle
# ==========================================

# Alamat Send-to-Kindle Anda (cek di Amazon -> Manage Your Content and Devices -> Preferences)
KINDLE_EMAIL=nama_anda@kindle.com

# Mode pengiriman email: "smtp" atau "apps_script"
# Gunakan "apps_script" jika hosting gratis memblokir port SMTP (465/587)
MAIL_MODE=smtp

# --- Opsi 1: Gmail SMTP (digunakan jika MAIL_MODE=smtp) ---
SMTP_HOST=smtp.gmail.com
# Gunakan 465 (SSL) atau 587 (STARTTLS)
SMTP_PORT=465
# Alamat Gmail pengirim (harus didaftarkan di Amazon Approved Personal Document E-mail List)
SMTP_USER=email_anda@gmail.com
# Gmail App Password 16 digit (bukan kata sandi login Gmail biasa)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Opsi 2: Google Apps Script Web App (digunakan jika MAIL_MODE=apps_script) ---
APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
APPS_SCRIPT_TOKEN=ganti-dengan-token-rahasia-panjang

# Port server (Render menyuntikkan PORT otomatis; Hugging Face Spaces default 7860)
PORT=7860
